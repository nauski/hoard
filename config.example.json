{
  "listen_addr": ":8080",
  "state_path": "/data/hoard-state.json",

  "hot": {
    "repository": "/data/hot",
    "password": "set-via-HOARD_HOT_PASSWORD-env"
  },

  "offsite": [
    {
      "id": "e2",
      "label": "IDrive e2",
      "default": true,
      "repository": "s3:https://x0x0.va.idrivee2-1.com/my-backup-bucket",
      "password": "set-via-HOARD_COLD_PASSWORD-env",
      "s3_access_key_id": "set-via-HOARD_COLD_S3_ACCESS_KEY_ID-env",
      "s3_secret_access_key": "set-via-HOARD_COLD_S3_SECRET_ACCESS_KEY-env",
      "limit_upload_kibps": 0,
      "limit_download_kibps": 0
    },
    {
      "id": "hetzner-box",
      "label": "Hetzner box",
      "default": false,
      "repository": "sftp://u123456@u123456.your-storagebox.de:23/hoard",
      "password": "repo-password-for-this-storage",
      "limit_upload_kibps": 0,
      "limit_download_kibps": 0
    }
  ],

  "routing": {
    "hourly-vm": ["hetzner-box"],
    "scratch-box": []
  },

  "schedule": {
    "mirror": "02:30",
    "check": "04:00",
    "check_weekday": 0,
    "verify": "05:00",
    "stale_after": "26h",
    "stale_after_hosts": { "hourly-vm": "3h" }
  },

  "retention": {
    "keep_last": 3,
    "keep_hourly": 0,
    "keep_daily": 7,
    "keep_weekly": 4,
    "keep_monthly": 6,
    "keep_yearly": 1,
    "keep_within": "",
    "apply_to_hot": false,
    "hosts": {
      "hourly-vm": { "keep_within": "48h", "keep_daily": 14, "keep_weekly": 8, "keep_monthly": 6 }
    }
  },

  "alert": {
    "webhook_url": "",
    "on_stale": true,
    "on_failure": true,
    "failure_threshold": 3
  },

  "smtp": {
    "host": "",
    "port": "587",
    "username": "",
    "password": "",
    "from": "",
    "to": ""
  }
}
